{
  "id": "./",
  "name": "Embarque · Tarjetas de embarque",
  "short_name": "Embarque",
  "description": "Guarda, muestra y gestiona tus tarjetas de embarque .pkpass sin conexión. Los datos se quedan en tu dispositivo.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#efece4",
  "theme_color": "#15171b",
  "categories": ["travel", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Añadir tarjeta", "short_name": "Añadir", "url": "./#/nueva", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mis tarjetas", "short_name": "Tarjetas", "url": "./#/tarjetas", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pass",
          "accept": ["application/vnd.apple.pkpass", "application/vnd-com.apple.pkpass", "application/octet-stream", "application/zip", ".pkpass"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/vnd.apple.pkpass": [".pkpass"] }
    }
  ]
}
